{
  "manifest_version": 3,
  "name": "undoomscroll",
  "version": "0.1.1",
  "description": "Unterbricht Doomscrolling mit Vokabelkarten Deutsch ↔ Chinesisch.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "action": {
    "default_title": "undoomscroll",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://m.youtube.com/*",
    "*://*.reddit.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://*.reddit.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "undoomscroll@ansghof",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
